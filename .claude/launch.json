{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "admin-web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "admin-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "admin-api",
        "start:dev"
      ],
      "port": 4000
    },
    {
      "name": "admin-web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "admin-web",
        "exec",
        "next",
        "start",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "clinic-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "clinic-web",
        "dev"
      ],
      "port": 3002
    },
    {
      "name": "clinic-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "clinic-api",
        "start:dev"
      ],
      "port": 4100
    },
    {
      "name": "landing",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "landing",
        "dev"
      ],
      "port": 3001
    }
  ]
}
